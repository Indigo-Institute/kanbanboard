# Optional: set a shared passphrase to gate the board behind a simple login.
# Leave unset for no gate (fine for quick local testing).
BACKLOG_PASSWORD=

# Supabase project connection. Create a project at supabase.com, run
# supabase/schema.sql in its SQL Editor, then fill these in from
# Project Settings -> API. If connecting via the Vercel Marketplace
# integration, SUPABASE_URL is added automatically — you only need to add
# SUPABASE_SERVICE_ROLE_KEY yourself (Vercel's integration only wires up the
# anon key by default, which is not enough for this app's server-side writes).
# Leave both unset to use local file storage for development.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
