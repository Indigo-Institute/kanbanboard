# Optional: set a shared passphrase to gate the board behind a simple login.
# Leave unset for no gate (fine for quick local testing).
BACKLOG_PASSWORD=

# These are added automatically when you connect an Upstash Redis store to
# this project via the Vercel Marketplace (Storage -> Create Database ->
# Redis / Upstash). You do not need to set them by hand for production.
# Depending on integration version they show up as either pair below —
# the app checks both.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
